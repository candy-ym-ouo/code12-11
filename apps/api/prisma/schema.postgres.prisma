// 该文件由 scripts/sync-postgres-schema.mjs 从 schema.prisma 生成，请勿手工编辑。
// 生成命令：pnpm --filter @nature/api db:sync-schema
// 自然观察时间线 · 数据模型
// 开发与测试使用 SQLite；生产可切换到 PostgreSQL（见 schema.postgres.prisma）。
// 枚举字段统一使用 String，避免两种数据库对 enum 的支持差异。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  role         String   @default("USER")
  timezone     String   @default("Asia/Shanghai")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens   RefreshToken[]
  sites           Site[]
  species         Species[]
  observations    Observation[]
  tags            Tag[]
  shareLinks      ShareLink[]
  transects       Transect[]
  transectEntries TransectEntry[]
  transectConflicts TransectConflict[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Site {
  id          String    @id @default(cuid())
  ownerId     String
  name        String
  latitude    Float?
  longitude   Float?
  elevationM  Int?
  habitat     String?
  description String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  observations Observation[]
  shareLinks   ShareLink[]
  transects    Transect[]

  @@unique([ownerId, name])
  @@index([ownerId, archivedAt])
}

model Species {
  id             String    @id @default(cuid())
  ownerId        String?
  category       String
  commonName     String
  scientificName String?
  family         String?
  description    String?
  isPreset       Boolean   @default(false)
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  owner        User?         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  phenophases  Phenophase[]
  observations Observation[]

  @@index([ownerId, category, commonName])
  @@index([category, commonName])
  @@index([isPreset])
}

model Phenophase {
  id         String  @id @default(cuid())
  speciesId  String
  name       String
  code       String?
  orderIndex Int     @default(0)
  color      String  @default("#3F6F52")
  isDefault  Boolean @default(false)

  species      Species       @relation(fields: [speciesId], references: [id], onDelete: Cascade)
  observations Observation[]

  @@unique([speciesId, name])
  @@index([speciesId, orderIndex])
}

model Observation {
  id              String    @id @default(cuid())
  ownerId         String
  siteId          String
  speciesId       String?
  phenophaseId    String?
  kind            String
  status          String    @default("PUBLISHED")
  observationDate String
  observedAt      DateTime?
  title           String?
  notes           String?
  temperatureC    Float?
  precipitationMm Float?
  windLevel       Int?
  humidityPct     Int?
  anomalyType     String?
  anomalySeverity String?
  impactNotes     String?
  source          String    @default("MANUAL")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  owner       User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  site        Site              @relation(fields: [siteId], references: [id], onDelete: Restrict)
  species     Species?          @relation(fields: [speciesId], references: [id], onDelete: SetNull)
  phenophase  Phenophase?       @relation(fields: [phenophaseId], references: [id], onDelete: SetNull)
  photos      ObservationPhoto[]
  tags        ObservationTag[]

  @@index([ownerId, status, observationDate])
  @@index([siteId, speciesId, phenophaseId, observationDate])
  @@index([ownerId, kind, observationDate])
  @@index([siteId, observationDate])
}

model ObservationPhoto {
  id            String    @id @default(cuid())
  observationId String
  storageKey    String    @unique
  thumbKey      String
  displayKey    String
  originalName  String
  mimeType      String
  width         Int
  height        Int
  bytes         Int
  takenAt       DateTime?
  gpsStripped   Boolean   @default(true)
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())

  observation Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)

  @@index([observationId, sortOrder])
}

model Tag {
  id        String   @id @default(cuid())
  ownerId   String
  name      String
  color     String   @default("#B0793A")
  createdAt DateTime @default(now())

  owner        User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  observations ObservationTag[]

  @@unique([ownerId, name])
}

model ObservationTag {
  observationId String
  tagId         String

  observation Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  tag         Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([observationId, tagId])
  @@index([tagId])
}

model ShareLink {
  id        String    @id @default(cuid())
  token     String    @unique
  siteId    String
  ownerId   String
  scope     String    @default("TIMELINE")
  expiresAt DateTime
  revokedAt DateTime?
  viewCount Int       @default(0)
  createdAt DateTime  @default(now())

  site  Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([siteId, revokedAt])
}

// ============================================================
// 样线调查（Line Transect Survey）
// 一条固定路线（Transect）划分为若干有序分段（Segment）；
// 每条录入（Entry）是「里程 × 时间」矩形内的一次物种/数量记录；
// 对齐引擎把所有录入切成互不重叠的片段，在时间线上可复核、可导出。
// ============================================================

model Transect {
  id          String    @id @default(cuid())
  ownerId     String
  siteId      String?
  name        String
  code        String?
  description String?
  // 路线总长度（米），由分段里程上界校验
  lengthM     Float     @default(0)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  owner     User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  site      Site?             @relation(fields: [siteId], references: [id], onDelete: SetNull)
  segments  TransectSegment[]
  entries   TransectEntry[]

  @@unique([ownerId, name])
  @@index([ownerId, archivedAt])
}

model TransectSegment {
  id          String   @id @default(cuid())
  transectId  String
  orderIndex  Int
  // 分段在整条样线上的里程区间（米），左闭右开
  startM      Float
  endM        Float
  name        String
  habitat     String?
  // 可选折线坐标 [lng,lat,alt?][]，用于 GeoJSON 导出
  geometry    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transect Transect         @relation(fields: [transectId], references: [id], onDelete: Cascade)
  entries  TransectEntry[]

  @@unique([transectId, orderIndex])
  @@index([transectId, startM])
}

model TransectEntry {
  id          String   @id @default(cuid())
  transectId  String
  ownerId     String
  segmentId   String?
  speciesId   String?
  speciesName String
  category    String?
  // 观测时间区间：瞬时记录 startAt == endAt
  startAt     DateTime
  endAt       DateTime
  // 里程区间（米），左闭右开；允许跨分段
  startM      Float
  endM        Float
  count       Int
  observer    String?
  notes       String?
  // MANUAL=现场录入；BACKFILL=事后补录（按 recordedAt 与既有结果对齐）
  source      String   @default("MANUAL")
  // 观测实际发生时间（补录时可能早于 createdAt）
  observedAt  DateTime
  recordedAt  DateTime @default(now())
  supersedesEntryId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transect  Transect        @relation(fields: [transectId], references: [id], onDelete: Cascade)
  segment   TransectSegment? @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  owner     User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([transectId, speciesName, startAt])
  @@index([transectId, startM, endM])
  @@index([ownerId, source])
}

// 同一物种的两条录入在「里程 × 时间」上相交时产生一条冲突；
// 对齐结果由录入确定性重算，冲突与处理决定持久化，便于复核与审计。
model TransectConflict {
  id           String    @id @default(cuid())
  transectId   String
  ownerId      String
  speciesName  String
  entryAId     String
  entryBId     String
  // 相交矩形
  startM       Float
  endM         Float
  startAt      DateTime
  endAt        DateTime
  countA       Int
  countB       Int
  // PENDING / KEEP_A / KEEP_B / SUM / DUPLICATE
  resolution   String    @default("PENDING")
  resolvedAt   DateTime?
  resolvedNote String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([entryAId, entryBId])
  @@index([transectId, resolution])
  @@index([ownerId, resolution])
}
